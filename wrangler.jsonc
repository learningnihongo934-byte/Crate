{
  // Crate: static site in dist/ plus a Worker for /api/* (art proxy, rooms, smart-playlist vault + daily cron)
  "name": "crate",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Vault"] }],
  // daily smart-playlist refresh, 09:00 UTC
  "triggers": { "crons": ["0 9 * * *"] },
  // crate.rennko.tech/* is more specific than Rennko Cloud's *.rennko.tech/* route, so this host stays here
  "routes": [
    { "pattern": "crate.rennko.tech", "custom_domain": true },
    { "pattern": "crate.rennko.tech/*", "zone_name": "rennko.tech" }
  ],
  "workers_dev": true
}
